<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">
    <TextView
        android:id="@+id/tvPortfolioTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Android Portfolio"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />
    <TextView
        android:id="@+id/tvPortfolioSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to my projects showcase"
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />
    <Button
        android:id="@+id/btnOpenAbout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go to About Me"
        android:layout_marginBottom="32dp" />
    <TextView
        android:id="@+id/tvFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="© 2026 Portfolio App - All Rights Reserved"
        android:layout_marginTop="450dp"
        android:textSize="12sp" />
</LinearLayout>